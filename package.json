{
  "name": "cc-desk",
  "productName": "CC Desk",
  "private": true,
  "version": "0.1.4",
  "description": "Desktop companion for Claude Code sessions, workspaces, and providers",
  "author": "CC Desk",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k -n server,web -c amber,cyan \"npm run server\" \"npm run web\"",
    "web": "vite",
    "server": "node server/index.js",
    "build": "tsc --noEmit && vite build",
    "electron:dev": "concurrently -k -n web,app -c cyan,magenta \"npm run web\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "electron:build": "npm run build && electron-builder --mac dir --publish never",
    "electron:dist": "npm run build && electron-builder --mac --publish never",
    "postinstall": "node -e \"try{require('fs').accessSync('node_modules/electron/dist/Electron.app')}catch{process.exit(0)}\" || bash scripts/install-electron.sh",
    "preview": "vite preview"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "diff": "^8.0.4",
    "express": "^4.21.2",
    "marked": "^18.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^35.1.2",
    "electron-builder": "^25.1.8",
    "typescript": "~5.7.2",
    "vite": "^6.2.0",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "local.cc.desk",
    "productName": "CC Desk",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "server/**/*",
      "electron/**/*",
      "!data/**",
      "!**/workspaces.json",
      "!**/providers.json",
      "package.json"
    ],
    "asar": true,
    "icon": "build/icons/icon.png",
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icons/icon.icns",
      "target": [
        "dir",
        "dmg"
      ],
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "artifactName": "CC-Desk-${version}-${arch}.${ext}",
      "title": "CC Desk"
    }
  }
}
